# ---- LLM provider -------------------------------------------------------
# Required unless callers pass their own key via the X-OpenAI-Key header.
OPENAI_API_KEY=sk-...
# Optional: point at Azure OpenAI, a gateway, or a local compatible server.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model used by the orchestrator (planning + synthesis). Needs good reasoning.
ORCHESTRATOR_MODEL=gpt-4.1
# Model used by the specialist agents. Cheaper is fine.
AGENT_MODEL=gpt-4.1-mini

# ---- Runtime guardrails -------------------------------------------------
MAX_PLAN_STEPS=6
MAX_REPLAN_ROUNDS=1
MAX_AGENT_ITERATIONS=6
STEP_TIMEOUT_SECONDS=90
RUN_TIMEOUT_SECONDS=300
MAX_PARALLEL_STEPS=4

# ---- Service ------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
ENVIRONMENT=local
